      "boundElements": [],
      "updated": 1788390828002,
      "link": null,
      "locked": false,
      "text": "NFR:\n- eventual consistency for SMS\n- high availability for feed consumption\n- High durability, avoid losing photos\n- no duplicates\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR:\n- eventual consistency for SMS\n- high availability for feed consumption\n- High durability, avoid losing photos\n- no duplicates\n",
