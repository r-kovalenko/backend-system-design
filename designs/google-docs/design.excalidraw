      "text": "WS /docs/{docId}\n  SEND {\n    type: \"insert\"\n    ....\n  }\n\n  SEND {\n    type: \"updateCursor\"\n    position: ...\n  }\n\n  SEND { \n    type: \"delete\"\n    ...\n  }\n\n  RECV { \n    type: \"update\"\n    ...\n  }",
