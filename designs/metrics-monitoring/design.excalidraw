      "text": "API:\nPOST /metrics/ingest\n{\n    metrics: [\n        {name: 'cpu_usage',\n         labels: {\"host\": \"server-1\"},\n         value: \"0.75\",\n         timestamp: 1640000000\n        },\n        ...\n    ]\n}\n",
