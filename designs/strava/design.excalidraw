      "seed": 268600939,
      "version": 284,
      "versionNonce": 2076211557,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779228594854,
      "link": null,
      "locked": false,
      "text": "API:\nPOST /activities -> Activity\nHeader: JWT\n{\n    type: \"RUN\",\n}\n\nPATCH /activities/:activityId -> Activity\nHeader: JWT\n{\n    state: \"STARTED\" | \"PAUSED\" | \"COMPLETED\",\n}\n\nPOST /activities/:activityId/routes -> Activity\nHeader: JWT\n{\n    latitude: number,\n    longintude: number\n}\n\nGET /activities?mode={USER|FRIEND}&page={page}&pageSize={pageSize} -> Activity[]\nHeader: JWT\n\nGET /activities/:activityId -> Activity\nHeader: JWT\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API:\nPOST /activities -> Activity\nHeader: JWT\n{\n    type: \"RUN\",\n}\n\nPATCH /activities/:activityId -> Activity\nHeader: JWT\n{\n    state: \"STARTED\" | \"PAUSED\" | \"COMPLETED\",\n}\n\nPOST /activities/:activityId/routes -> Activity\nHeader: JWT\n{\n    latitude: number,\n    longintude: number\n}\n\nGET /activities?mode={USER|FRIEND}&page={page}&pageSize={pageSize} -> Activity[]\nHeader: JWT\n\nGET /activities/:activityId -> Activity\nHeader: JWT\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
