    {
      "id": "hPYIe0LXnwJzMlAUxK9_2",
      "type": "text",
      "x": 5993.179744819678,
      "y": -236709.42472459964,
      "width": 1561.0675048828125,
      "height": 1170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMI",
