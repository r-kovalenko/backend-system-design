      "boundElements": [],
      "updated": 1773799674790,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n. users can post comments\n. users can see comments as they are posted\n. users can see the comments which were posted before they joined to watch a video",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n. users can post comments\n. users can see comments as they are posted\n. users can see the comments which were posted before they joined to watch a video",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "nt7na9I-4hbLkZqtx0L36",
      "type": "text",
      "x": 28.432541568818124,
      "y": -161515.9351267922,
      "width": 415.4333190917969,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
