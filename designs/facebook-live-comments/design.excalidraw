      "isDeleted": false,
      "boundElements": [],
      "updated": 1773799674790,
      "link": null,
      "locked": false,
      "text": "Scale:\n. millions of concurrent live videos\n. thousands of comments / second / video",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scale:\n. millions of concurrent live videos\n. thousands of comments / second / video",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
