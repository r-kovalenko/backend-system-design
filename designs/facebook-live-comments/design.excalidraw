      "versionNonce": 155395446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773799674790,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n. availability >> consistency (eventual consistency is acceptable)\n. low latency comment broadcast <200ms (near-realtime)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n. availability >> consistency (eventual consistency is acceptable)\n. low latency comment broadcast <200ms (near-realtime)",
