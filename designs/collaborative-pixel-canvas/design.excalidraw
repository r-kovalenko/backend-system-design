      "updated": 1787180465062,
      "link": null,
      "locked": false,
      "text": "Write QPS: 1,000,000 users / 300 seconds (5 min) = ~3,300 writes/sec. Peak: ~10,000 writes/sec.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Write QPS: 1,000,000 users / 300 seconds (5 min) = ~3,300 writes/sec. Peak: ~10,000 writes/sec.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "zuIh-1gweoZFdakGgYaiE",
      "type": "text",
      "x": 6991.67820480066,
      "y": -276412.0341804915,
      "width": 1922.039306640625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
