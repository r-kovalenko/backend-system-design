      "seed": 867206711,
      "version": 7,
      "versionNonce": 637529591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787180462714,
      "link": null,
      "locked": false,
      "text": "Broadcast / Fan-out: 3,300 writes/sec × 1,000,000 active WebSocket connections = ~3.3 Billion pushes/sec.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Broadcast / Fan-out: 3,300 writes/sec × 1,000,000 active WebSocket connections = ~3.3 Billion pushes/sec.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "9zpWlofU52M2Vw_GrfM9r",
      "type": "text",
      "x": 6991.67820480066,
      "y": -276330.43423542316,
      "width": 1543.0677490234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bV7",
      "roundness": null,
      "seed": 1434274073,
      "version": 7,
      "versionNonce": 379444759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787180452859,
      "link": null,
      "locked": false,
      "text": "Storage (Canvas State): 1000 × 1000 = 1M pixels. At 3 bytes (RGB) per pixel = ~3 MB.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage (Canvas State): 1000 × 1000 = 1M pixels. At 3 bytes (RGB) per pixel = ~3 MB.",
