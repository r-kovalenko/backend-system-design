      "boundElements": [],
      "updated": 1787180466582,
      "link": null,
      "locked": false,
      "text": "Storage (Event Log): ~3,300 writes/sec × 86,400 seconds = ~285 Million writes/day. At ~20 bytes per event = ~5.7 GB/day.",
