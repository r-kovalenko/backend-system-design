      "boundElements": [],
      "updated": 1778011549749,
      "link": null,
      "locked": false,
      "text": "GET /symbol/:name\nHeader JWT\n -> Symbol\n\nPOST /order\nHeader JWT\nReuqest: {\n    type: 'buy' | 'sell'\n    symbol: 'META'\n    price: 101.01\n    num: 10\n}\n-> Order\n\nDELETE /order/:id\nHeader JWT\n-> {\n    ok: true\n}\n\nGET /orders\nHeader JWT\n-> Order[]",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GET /symbol/:name\nHeader JWT\n -> Symbol\n\nPOST /order\nHeader JWT\nReuqest: {\n    type: 'buy' | 'sell'\n    symbol: 'META'\n    price: 101.01\n    num: 10\n}\n-> Order\n\nDELETE /order/:id\nHeader JWT\n-> {\n    ok: true\n}\n\nGET /orders\nHeader JWT\n-> Order[]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
