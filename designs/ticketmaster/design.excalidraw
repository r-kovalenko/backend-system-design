      "isDeleted": false,
      "boundElements": [],
      "updated": 1779236166230,
      "link": null,
      "locked": false,
      "text": "- Availability for searching & viewing events\n- Consistency for booking events (no double booking)\n- Handle popular events\n- low latency search (<500ms)\n- Read >> write",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Availability for searching & viewing events\n- Consistency for booking events (no double booking)\n- Handle popular events\n- low latency search (<500ms)\n- Read >> write",
