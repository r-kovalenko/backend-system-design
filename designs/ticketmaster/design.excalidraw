      "updated": 1779236126656,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n- View upcoming events\n- Book tickets to upcoming events\n- Search for upcoming events",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n- View upcoming events\n- Book tickets to upcoming events\n- Search for upcoming events",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "aeYUT1kdl1nJnsL3etVrM",
      "type": "text",
      "x": 6519.347302853939,
      "y": -243074.95765815274,
      "width": 933.8756103515625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
