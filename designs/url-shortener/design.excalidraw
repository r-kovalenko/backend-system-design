      "updated": 1773271434678,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n- create short URL from long URL\n   - optionally alias for short URL\n   - optionally expiration date\n- use redirect from short URL to long URL\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n- create short URL from long URL\n   - optionally alias for short URL\n   - optionally expiration date\n- use redirect from short URL to long URL\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
